root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# C and C++: two spaces and a 100-column line, as in MeshCore and the agent firmware, whose sources
# ours sit beside.
[*.{c,cpp,h,hpp,inc}]
indent_size = 2
max_line_length = 100

[*.{yml,yaml,json,ini}]
indent_size = 2

[*.ps1]
indent_size = 4

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Not ours to reformat: what the component manager fetches, and everything the build writes.
[{build,managed_components}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# A copy, compared by hash: nothing may reformat it.
[spec/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
